# ─── Django ────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=replace-with-50+-random-chars
DEBUG=False
ALLOWED_HOSTS=your-app.railway.app,localhost

# ─── Database (Railway injects this automatically) ──────────────────────
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ─── Email via Resend ──────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=reports@umojaexchange.com
REPORT_EMAIL=admin@umojaexchange.com

# ─── CORS (dev only — in production same-origin, no CORS needed) ───────
CORS_ALLOWED_ORIGINS=http://localhost:5173

DJANGO_ADMIN_USERNAME=admin
DJANGO_ADMIN_EMAIL=admin@umojaexchange.com
DJANGO_ADMIN_PASSWORD=Admin@1234!

# ── Frontend (Vite) ─────────────────────────────────────────────────
# Only needed for local dev (proxy to Django on :8000).
# In production the SPA is served by Django/WhiteNoise — no CORS needed.
VITE_API_BASE_URL=/api/v1