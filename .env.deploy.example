# =============================================================================
# .env.deploy — config for deploy_cpanel.sh and the `make cpanel-*`
# helpers. Copy to .env.deploy (gitignored) and fill in. Never commit secrets.
# =============================================================================

# ── SSH (from cPanel → SSH Access) ───────────────────────────────────────────
SSH_HOST=umojaexchange.co.tz
SSH_USER=kitongalimited            # your cPanel username
SSH_PORT=22                        # cPanel often uses a non-standard port (e.g. 27522)
SSH_KEY=.ssh/umoja_deploy          # path to the PRIVATE key, relative to repo root

# ── Remote layout ────────────────────────────────────────────────────────────
# REMOTE_DIR = the cPanel Python App's "Application root" (NOT public_html).
# This is where backend/ is rsynced and where passenger_wsgi.py + .env live.
REMOTE_DIR=/home/kitongalimited/umoja_exchange

# The exact "source .../activate" command cPanel shows in the Python App page.
# MUST be quoted — it contains a space, or the shell tries to run it locally.
VENV_ACTIVATE="source /home/umojaexc/virtualenv/umoja_exchange/3.11/bin/activate"

# ── Optional ─────────────────────────────────────────────────────────────────
PYTHON_BIN=python                  # local python used for collectstatic (your .venv)
DEPLOY_URL=https://umojaexchange.co.tz   # post-deploy health check (hits /api/health/)

# Absolute path to rsync ON THE SERVER. cPanel's jailed shell often doesn't have
# rsync on PATH ("jailshell: rsync: command not found") — set the full path here.
# Find it with: ssh ... "command -v rsync || ls /usr/bin/rsync"
REMOTE_RSYNC=/usr/bin/rsync
